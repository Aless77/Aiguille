# Copier vers .env pour surcharger les valeurs par défaut (facultatif en local).
# Ne jamais commiter .env : les secrets restent hors du dépôt.

# URL publique du site, utilisée pour les balises canoniques, le sitemap et Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Base de données. En local, compose.yaml fournit déjà la bonne valeur.
# DATABASE_URL=postgres://aiguille:aiguille@db:5432/aiguille

# User-Agent identifiable du scraper (règle de collecte du cahier des charges).
SCRAPER_USER_AGENT=AiguilleBot/0.1 (+https://github.com/Aless77/Aiguille)

# Invalidation du cache du site après une collecte (route POST /api/revalidate).
# Même valeur secrète dans Vercel et dans les secrets GitHub Actions. Facultatif en local.
# REVALIDATE_SECRET=
# URL du site appelée par le scraper (GitHub Actions) pour cette invalidation.
# SITE_URL=https://aiguille.aless-villa.com
