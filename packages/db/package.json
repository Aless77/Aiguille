{
  "name": "@aiguille/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./rating": "./src/rating.ts",
    "./facts": "./src/facts.ts",
    "./brand-info": "./src/brand-info.ts",
    "./compare": "./src/compare.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "migrate": "drizzle-kit migrate",
    "seed": "tsx src/seed.ts",
    "seed:e2e": "tsx src/seed-e2e.ts",
    "scores": "tsx src/refresh-scores.ts",
    "couverture": "tsx src/coverage-report.ts",
    "studio": "drizzle-kit studio --host 0.0.0.0",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "postgres": "^3.4.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
